{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scalekit Admin Portal Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue an access token (client credentials)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.scalekit.com/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Exchange a client_id and client_secret for a short-lived Bearer access token using the OAuth 2.0 client credentials grant. The returned token authorizes all subsequent management API calls."
        }
      ]
    }
  ],
  "bundled": true
}